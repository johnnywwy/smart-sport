# 运行 pnpm env:init 生成随机本地凭据；此模板不包含真实密钥。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
POSTGRES_USER=smart_sport
POSTGRES_DB=smart_sport
POSTGRES_PORT=15432
POSTGRES_PASSWORD=
REDIS_PORT=16379
REDIS_PASSWORD=
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=smart_sport
MINIO_ROOT_PASSWORD=
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=smart-sport
S3_ACCESS_KEY_ID=smart_sport
S3_SECRET_ACCESS_KEY=
# 32 字节随机密钥的 Base64 编码
FIELD_ENCRYPTION_KEY=
STUDENT_HMAC_KEY=
# Ed25519 PKCS8 DER 私钥的 Base64 编码；worker 不要求 JWT 配置。
JWT_PRIVATE_KEY=
JWT_KEY_ID=local-v1
