{
  "name": "smart-sport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @smart-sport/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node scripts/check-ui.mjs",
    "format": "biome check --write .",
    "setup:hero": "node scripts/setup-hero.mjs",
    "check:backend-deps": "turbo run build --filter=@smart-sport/config --filter=@smart-sport/contracts && node scripts/check-backend-deps.mjs",
    "env:init": "node scripts/init-env.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "test:config": "pnpm --filter @smart-sport/config test",
    "infra:check": "pnpm --filter @smart-sport/config build && pnpm --filter @smart-sport/server check:infra",
    "test:config-startup": "turbo run build --filter=@smart-sport/server --filter=@smart-sport/worker && node scripts/check-config-startup.mjs",
    "db:migrate": "turbo run build --filter=@smart-sport/server && pnpm --filter @smart-sport/server db:migrate",
    "prepare": "node scripts/setup-git.mjs",
    "commit": "cz",
    "test:unit": "turbo run test",
    "check:deps": "depcruise --config .dependency-cruiser.cjs apps/server/src apps/worker/src apps/web/src packages/contracts/src packages/domain/src packages/config/src",
    "test:deps": "node --test scripts/dependency-rules.test.mjs",
    "regions:import": "turbo run build --filter=@smart-sport/server && pnpm --filter @smart-sport/server regions:import",
    "seed:admin-identity": "turbo run build --filter=@smart-sport/server && pnpm --filter @smart-sport/server seed:admin-identity",
    "catalog:sync": "turbo run build --filter=@smart-sport/server && pnpm --filter @smart-sport/server catalog:sync",
    "tenant:provision": "turbo run build --filter=@smart-sport/worker && pnpm --filter @smart-sport/worker tenant:provision",
    "tenant:backfill": "turbo run build --filter=@smart-sport/worker && pnpm --filter @smart-sport/worker tenant:backfill"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "commitizen": "4.3.2",
    "cz-git": "1.14.0",
    "dependency-cruiser": "18.7.2",
    "husky": "9.1.7",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
