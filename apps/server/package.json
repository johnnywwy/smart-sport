{
  "name": "@smart-sport/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "check:infra": "node --env-file-if-exists=../../.env scripts/check-infra.mjs",
    "db:migrate": "node --env-file-if-exists=../../.env dist/database/migrate-cli.js",
    "catalog:sync": "node --env-file-if-exists=../../.env dist/modules/platform/catalog/sync-cli.js",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "regions:import": "node --env-file-if-exists=../../.env dist/modules/platform/regions/import-cli.js ../../deploy/seed/regions.csv",
    "seed:admin-identity": "node --env-file-if-exists=../../.env dist/modules/platform/identities/seed-admin-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@nestjs/bullmq": "12.0.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@smart-sport/config": "workspace:*",
    "@smart-sport/contracts": "workspace:*",
    "argon2": "0.45.2",
    "bullmq": "6.7.2",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "jose": "6.2.16",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "testcontainers": "12.2.1",
    "vitest": "5.1.0"
  }
}
